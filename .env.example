# Bo'sh qoldirilsa, lokal PGlite (./.pglite) ishlatiladi — hech narsa sozlash shart emas
DATABASE_URL=
# 32+ belgili maxfiy kalit
AUTH_SECRET=change-me-to-a-long-random-string-123456
# Admin panelga kirish paroli (/admin/login)
ADMIN_PASSWORD=admin12345
# AI import uchun (savollarni matn/DOCX/PDF dan ajratish)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Bo'sh qoldirilsa, fayllar public/uploads ga saqlanadi
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media
NEXT_PUBLIC_SITE_URL=

# ── To'lov (ixtiyoriy). Bo'sh bo'lsa, buyurtmalar admin orqali qo'lda tasdiqlanadi ──
# Payme: kabinetda Endpoint = https://<domen>/api/payme ; kalit = "Key" (test rejimda "Test key")
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=0
# Click: Shop API manzillari = https://<domen>/api/click/prepare  va  /api/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ── SMS (ixtiyoriy): parolni tiklash kodi. Eskiz.uz akkaunti kerak ──
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
